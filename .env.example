# 本地开发用：复制本文件为 .env 后填写
# .env 已在 .gitignore 中，不会被提交到 GitHub

# 会话签名密钥。生产环境必须在 Vercel 后台配置
SECRET_KEY=

# 数据库连接串。本地留空即使用 SQLite；部署到 Vercel 时填 Neon 的连接串
DATABASE_URL=

# 管理后台（/admin）密码。生产环境务必修改，不要用默认值
ADMIN_PASSWORD=

# 邮件服务（找回密码用）。留空则走演示模式：重置链接直接显示在页面上
# 以 QQ 邮箱为例：MAIL_SERVER=smtp.qq.com，MAIL_PORT=465，密码填「授权码」不是登录密码
MAIL_SERVER=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_USE_SSL=1

# 邀请码默认额度
INVITE_MAX_USES=5
